# ==============================================================================
# HoYoLAB Check-In Configuration
# ==============================================================================

# Your HoYoLAB Cookie string.
# To get this from Arc / Chrome / Edge:
# 1. Go to your HoYoLAB check-in tab (or https://act.hoyolab.com/)
# 2. Press Cmd + Option + I to open Developer Tools.
# 3. Go to Application tab -> Cookies -> https://act.hoyolab.com
#    Copy the values of `ltoken_v2` and `ltuid_v2`
#    Format: HOYO_COOKIE="ltoken_v2=v2_...; ltuid_v2=...;"
#
# OR:
# Go to Network tab -> refresh the page -> click any request (e.g. `info`)
# -> Scroll to Request Headers -> Copy the entire `Cookie` value!
HOYO_COOKIE="ltuid_v2=YOUR_LTUID_V2; ltoken_v2=YOUR_LTOKEN_V2;"

# Optional: Enable Zenless Zone Zero check-in (true / false)
ENABLE_ZZZ=false

# Optional: Always show macOS notification after check-in (true / false)
NOTIFY_MACOS=true

# Optional: Discord Webhook URL for daily notifications
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional: If you want to check in multiple accounts together, define additional cookies:
# HOYO_COOKIE_2="ltuid_v2=ACCOUNT2_ID; ltoken_v2=ACCOUNT2_TOKEN;"
